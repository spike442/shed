{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "secret", "clickhouse", "s3", "networkPolicy"],
  "properties": {
    "global": {"type": "object"},
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository"],
      "properties": {"repository": {"$ref": "#/definitions/name"}, "tag": {"type": "string"}}
    },
    "secret": {"$ref": "#/definitions/name"},
    "clickhouse": {
      "type": "object", "additionalProperties": false, "required": ["host", "database", "user"],
      "properties": {
        "host": {"$ref": "#/definitions/name"},
        "database": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "user": {"$ref": "#/definitions/name"}
      }
    },
    "s3": {
      "type": "object", "additionalProperties": false, "required": ["endpoint", "region"],
      "properties": {"endpoint": {"$ref": "#/definitions/name"}, "region": {"$ref": "#/definitions/name"}}
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "definitions": {
    "name": {"type": "string", "minLength": 1}
  }
}
