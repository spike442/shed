{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "secret", "domainSecrets", "clickhouse", "s3", "networkPolicy"],
  "additionalProperties": false,
  "properties": {
    "global": {"type": "object"},
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"}
      }
    },
    "secret": {"type": "string", "minLength": 1},
    "domainSecrets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "clickhouse": {
      "type": "object",
      "required": ["host", "database", "user"],
      "additionalProperties": false,
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "database": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "user": {"type": "string", "minLength": 1}
      }
    },
    "s3": {
      "type": "object",
      "required": ["endpoint", "region"],
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "clients"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "clients": {
          "type": "array",
          "items": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
        }
      }
    }
  }
}
