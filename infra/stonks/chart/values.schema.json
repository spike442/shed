{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "secret", "s3", "search", "llm", "airflow", "route"],
  "properties": {
    "global": {"type": "object"},
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository"],
      "properties": {"repository": {"$ref": "#/definitions/name"}, "tag": {"type": "string"}}
    },
    "secret": {"$ref": "#/definitions/name"},
    "s3": {
      "type": "object", "additionalProperties": false, "required": ["endpoint", "region", "bucket"],
      "properties": {"endpoint": {"$ref": "#/definitions/name"}, "region": {"$ref": "#/definitions/name"}, "bucket": {"$ref": "#/definitions/name"}}
    },
    "search": {
      "type": "object", "additionalProperties": false, "required": ["url"],
      "properties": {"url": {"$ref": "#/definitions/name"}}
    },
    "llm": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "base_url": {"$ref": "#/definitions/name"},
        "model": {"$ref": "#/definitions/name"},
        "max_retries": {"type": "integer", "minimum": 0},
        "request_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "airflow": {
      "type": "object", "additionalProperties": false, "required": ["namespace", "serviceAccount"],
      "properties": {"namespace": {"$ref": "#/definitions/name"}, "serviceAccount": {"$ref": "#/definitions/name"}}
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["hostname", "gatewayName", "gatewayNamespace"],
      "properties": {"hostname": {"$ref": "#/definitions/name"}, "gatewayName": {"$ref": "#/definitions/name"}, "gatewayNamespace": {"$ref": "#/definitions/name"}}
    }
  },
  "definitions": {
    "name": {"type": "string", "minLength": 1}
  }
}
