{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "secret", "agents", "postgres", "kafka", "domains", "networkPolicy", "route"],
  "properties": {
    "global": {"type": "object"},
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository"],
      "properties": {"repository": {"$ref": "#/definitions/name"}, "tag": {"type": "string"}}
    },
    "secret": {"$ref": "#/definitions/name"},
    "agents": {"type": "array", "uniqueItems": true, "items": {"enum": ["pr-review", "sre"]}},
    "postgres": {
      "type": "object", "additionalProperties": false, "required": ["host", "database", "user"],
      "properties": {"host": {"$ref": "#/definitions/name"}, "database": {"$ref": "#/definitions/name"}, "user": {"$ref": "#/definitions/name"}}
    },
    "kafka": {
      "type": "object", "additionalProperties": false, "required": ["bootstrapServers", "username", "consumerGroup", "topics"],
      "properties": {
        "bootstrapServers": {"$ref": "#/definitions/name"},
        "username": {"$ref": "#/definitions/name"},
        "consumerGroup": {"$ref": "#/definitions/name"},
        "topics": {"type": "object", "additionalProperties": {"$ref": "#/definitions/name"}}
      }
    },
    "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "domains": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "api"],
        "properties": {"id": {"$ref": "#/definitions/name"}, "api": {"type": "string", "pattern": "^/"}, "icon": {"$ref": "#/definitions/name"}}
      }
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "monitoringNamespace"],
      "properties": {"enabled": {"type": "boolean"}, "monitoringNamespace": {"$ref": "#/definitions/name"}}
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["hostname", "gatewayName", "gatewayNamespace"],
      "properties": {"hostname": {"$ref": "#/definitions/name"}, "gatewayName": {"$ref": "#/definitions/name"}, "gatewayNamespace": {"$ref": "#/definitions/name"}}
    }
  },
  "definitions": {
    "name": {"type": "string", "minLength": 1}
  }
}
